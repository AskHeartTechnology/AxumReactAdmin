APP_ENV=development

# server ---> toml [server]
APP_SERVER__HOST=0.0.0.0
APP_SERVER__PORT=8088
APP_SERVER__MODE=development

# database ---> toml [database]
APP_DATABASE__URL=postgres://postgres:postgres@localhost:54321/ara?options=--search_path=ara
APP_DATABASE__MAX_CONNECTIONS=20
APP_DATABASE__MIN_CONNECTIONS=5

# jwt ---> toml [jwt]
APP_JWT__SECRET=ara-json-web-token-secret

# swagger ---> toml [swagger]
APP_SWAGGER__USERNAME=admin
APP_SWAGGER__PASSWORD=ara123456

